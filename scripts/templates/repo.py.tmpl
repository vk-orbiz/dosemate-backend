"""Data access for {{plural}}. Returns domain models, raises domain errors (rules 3, 4, 7).

Every query is scoped by `user_id`: another user's row is reported as not found.
"""

from datetime import datetime
from uuid import UUID

from app.core.errors import {{Name}}NotFound
from app.models.{{name}} import {{Name}}, {{Name}}Draft
from app.repo.entities.{{name}} import {{Name}}Entity
from app.storage.postgres import tables
from app.storage.postgres.db import Postgres

_COLUMNS = ", ".join(("id", "user_id", {{columns_quoted}}, "created_at", "updated_at"))
_INSERT = f"""
    INSERT INTO {tables.{{PLURAL}}} ({_COLUMNS})
    VALUES ({{insert_placeholders}})
"""
_LIST = f"""
    SELECT {_COLUMNS} FROM {tables.{{PLURAL}}}
    WHERE user_id = $1
    ORDER BY created_at DESC, id
    LIMIT $2 OFFSET $3
"""
_GET = f"SELECT {_COLUMNS} FROM {tables.{{PLURAL}}} WHERE id = $1 AND user_id = $2"
_UPDATE = f"""
    UPDATE {tables.{{PLURAL}}}
    SET
        {{update_set}}
        updated_at = ${{updated_at_param}}
    WHERE id = $1 AND user_id = $2
    RETURNING {_COLUMNS}
"""
_DELETE = f"DELETE FROM {tables.{{PLURAL}}} WHERE id = $1 AND user_id = $2"


class {{Name}}Repo:
    """Structurally satisfies `service.protocols.{{Name}}Repository`."""

    def __init__(self, db: Postgres) -> None:
        self._db = db

    async def create(self, {{name}}: {{Name}}) -> None:
        e = {{Name}}Entity.from_model({{name}})
        await self._db.pool.execute(
            _INSERT, e.id, e.user_id, {{entity_args}}, e.created_at, e.updated_at
        )

    async def list_by_user(self, user_id: UUID, *, limit: int, offset: int) -> list[{{Name}}]:
        records = await self._db.pool.fetch(_LIST, user_id, limit, offset)
        return [{{Name}}Entity.from_record(r).to_model() for r in records]

    async def get(self, user_id: UUID, {{name}}_id: UUID) -> {{Name}}:
        record = await self._db.pool.fetchrow(_GET, {{name}}_id, user_id)
        if record is None:
            raise {{Name}}NotFound()
        return {{Name}}Entity.from_record(record).to_model()

    async def update(
        self, user_id: UUID, {{name}}_id: UUID, draft: {{Name}}Draft, updated_at: datetime
    ) -> {{Name}}:
        record = await self._db.pool.fetchrow(
            _UPDATE, {{name}}_id, user_id, {{draft_args}}, updated_at
        )
        if record is None:
            raise {{Name}}NotFound()
        return {{Name}}Entity.from_record(record).to_model()

    async def delete(self, user_id: UUID, {{name}}_id: UUID) -> None:
        result = await self._db.pool.execute(_DELETE, {{name}}_id, user_id)
        if result == "DELETE 0":
            raise {{Name}}NotFound()
