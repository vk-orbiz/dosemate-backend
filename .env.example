# Copy to .env (development) or .env.production. All keys use the DOSEMATE_ prefix.
DOSEMATE_ENV=development
DOSEMATE_LOG_LEVEL=INFO
DOSEMATE_DATABASE_URL=postgresql://dosemate:dosemate@localhost:5434/dosemate
DOSEMATE_DB_POOL_MIN_SIZE=1
DOSEMATE_DB_POOL_MAX_SIZE=10
# At least 32 characters. The development default is rejected when ENV=production.
DOSEMATE_JWT_SECRET=dev-only-secret-change-me-0123456789
DOSEMATE_JWT_TTL_SECONDS=3600
# JSON list.
DOSEMATE_CORS_ORIGINS=["http://localhost:3000"]
